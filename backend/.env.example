PORT=4000
# Never commit the real value. Rotate the password that was previously hardcoded in db-conn.ts.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=workers_registry
JWT_SECRET=change-me-jwt
OTP_SECRET=change-me-otp
IDENTITY_HASH_SECRET=change-me-identity-hash

# GCS image uploads (private bucket). Server starts without these; upload APIs return 503 until GCS_BUCKET is set.
GCS_BUCKET=your-private-bucket
GCS_PROJECT_ID=your-gcp-project-id
# Preferred: path to service-account JSON (gitignored). Do not commit the JSON.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcs-service-account.json
# Alternative: inline fields (escape newlines in the private key as \n)
# GCS_CLIENT_EMAIL=your-sa@your-gcp-project-id.iam.gserviceaccount.com
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
